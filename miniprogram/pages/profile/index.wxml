<view class="page">

  <!-- 用户 -->
  <view class="card user-card">
    <view class="avatar">{{initial}}</view>
    <view class="flex-1 col user-info">
      <block wx:if="{{!editing}}">
        <text class="user-name">{{nickname || '未设置昵称'}}</text>
        <text class="muted" bindtap="startEdit">点击修改昵称</text>
      </block>
      <block wx:else>
        <input
          class="nickname-input"
          type="nickname"
          placeholder="输入昵称"
          placeholder-class="form-placeholder"
          value="{{nickname}}"
          bindinput="onNicknameInput"
          focus
        />
        <view class="nickname-actions">
          <text class="mini-link" bindtap="cancelEdit">取消</text>
          <text class="mini-link mini-link--primary" bindtap="saveNickname">
            {{saving ? '保存中…' : '保存'}}
          </text>
        </view>
      </block>
    </view>
  </view>

  <!-- 数据 -->
  <view class="card card-tight">
    <view class="list-item list-item--tap" bindtap="goAccounts">
      <text class="flex-1">投资账户</text>
      <text class="muted">{{accountCount}} 个</text>
      <text class="chevron">›</text>
    </view>
    <view class="list-item list-item--tap" bindtap="goHoldings">
      <text class="flex-1">我的持仓</text>
      <text class="chevron">›</text>
    </view>
    <view class="list-item list-item--tap" bindtap="goCalendar">
      <text class="flex-1">分红日历</text>
      <text class="chevron">›</text>
    </view>
  </view>

  <!-- 开发工具（生产环境不该出现，用 env 控制） -->
  <view wx:if="{{env === 'dev'}}" class="section-head">
    <text class="section-title">开发工具</text>
  </view>

  <view wx:if="{{env === 'dev'}}" class="card card-tight">
    <view class="list-item list-item--tap" bindtap="showBaseUrl">
      <text class="flex-1">后端地址</text>
      <text class="muted ellipsis url-text">{{baseUrl}}</text>
      <text class="chevron">›</text>
    </view>
    <view class="list-item list-item--tap" bindtap="switchUser">
      <text class="flex-1">切换开发身份</text>
      <text class="muted ellipsis url-text">{{devOpenid || '未固定'}}</text>
      <text class="chevron">›</text>
    </view>
  </view>

  <!-- 账号 -->
  <view class="card card-tight">
    <view class="list-item list-item--tap" bindtap="logout">
      <text class="flex-1 c-danger">退出登录</text>
    </view>
  </view>

  <view class="about">分红管家 v0.1.0</view>

</view>
