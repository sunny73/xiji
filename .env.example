# ---------------------------------------------------------------------------
# 生产部署用的 docker compose 变量
#
#   cp .env.example .env && vim .env
#   docker compose -f docker-compose.yml up -d --build
#
# ⚠️ 这个文件和 backend/.env 是两回事：
#   - 这个（仓库根目录）给 docker compose 做变量替换用，控制容器怎么起
#   - backend/.env 是后端应用自己的配置，只在**本地不用容器**跑时才读
#   部署到服务器时，后端的环境变量全部由 docker-compose.yml 注入，不看 backend/.env。
# ---------------------------------------------------------------------------

# --- 运行环境 -------------------------------------------------------------
# prod 会触发启动自检：配置不全直接拒绝启动（而不是带着开发开关上线）
ENV=prod
DEBUG=false

# --- 数据库 ---------------------------------------------------------------
POSTGRES_USER=dividend
POSTGRES_PASSWORD=CHANGE_ME_用强密码
POSTGRES_DB=dividend
# 只监听本机，绝不要写成 0.0.0.0
POSTGRES_HOST_PORT=127.0.0.1:55432

# --- API ------------------------------------------------------------------
# 只监听本机，公网流量走 Nginx 反代
API_HOST_PORT=127.0.0.1:8000

# 生成方式：python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_至少32字节的随机串
JWT_EXPIRE_DAYS=30

# --- 微信小程序 -----------------------------------------------------------
# 小程序后台 → 开发 → 开发管理 → 开发设置
WECHAT_APPID=wx0000000000000000
WECHAT_SECRET=CHANGE_ME

# ⚠️ 下面两个必须保持 false，否则任何人都能伪造登录
WECHAT_MOCK=false
ALLOW_DEV_LOGIN=false

# --- CORS -----------------------------------------------------------------
# 小程序请求不受浏览器同源策略限制，正常情况下**不需要**开 CORS。
# 留空即可（后端就不会挂 CORS 中间件）。
# 只有在用网页/H5 直连这个后端时才填，例如：
# CORS_ORIGINS=https://your-web.example.com
CORS_ORIGINS=
