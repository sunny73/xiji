# ---------------------------------------------------------------------------
# 分红管家 后端环境变量
# 用法：cp .env.example .env 然后按需修改
# ---------------------------------------------------------------------------

# 运行环境：dev | test | prod
ENV=dev
DEBUG=true

# --- 数据库 --------------------------------------------------------------
# 本机 brew 安装的 PostgreSQL 16（推荐本地开发）
DATABASE_URL=postgresql+psycopg://dividend:dividend@localhost:5432/dividend
# Docker Compose 内网地址（docker compose up 时把 host 换成 db）
# DATABASE_URL=postgresql+psycopg://dividend:dividend@db:5432/dividend

# SQL 回显，排查问题时打开
SQL_ECHO=false

# --- JWT -----------------------------------------------------------------
# 生产环境必须替换：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# --- 微信小程序 -----------------------------------------------------------
# 微信公众平台 → 开发 → 开发设置 里获取
WECHAT_APPID=
WECHAT_SECRET=

# code2session 的 mock 开关。
# true  = 不发真实请求，openid 直接由 code 推导（本地开发/自动化测试用）
# false = 调用 https://api.weixin.qq.com/sns/jscode2session
WECHAT_MOCK=true

# 是否开放 /api/v1/auth/dev-login（仅本地 curl / Swagger 调试用，生产必须 false）
ALLOW_DEV_LOGIN=true

# --- CORS ----------------------------------------------------------------
# 逗号分隔；微信小程序请求不受浏览器同源策略限制，这里主要给 Swagger / 网页调试用
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
